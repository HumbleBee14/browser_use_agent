# --- LLM Provider Configuration ---
# Supported: anthropic, openai, google, gemini, browser_use
LLM_PROVIDER=anthropic

# Model name (optional — defaults shown below per provider)
# LLM_MODEL=claude-sonnet-4-20250514   # anthropic default
# LLM_MODEL=gpt-4o                     # openai default
# LLM_MODEL=gemini-2.0-flash           # google default

# --- API Keys (set the one matching your LLM_PROVIDER) ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
# OPENAI_API_KEY=sk-xxxxx
# GOOGLE_API_KEY=xxxxx
# BROWSER_USE_API_KEY=xxxxx

# --- Browser Settings ---
# HEADLESS=false
# MAX_CONCURRENT=3
