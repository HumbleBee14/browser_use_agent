# --- LLM Provider Configuration ---
# Supported: anthropic, openai, gemini, browser_use
LLM_PROVIDER=anthropic

# Model name (optional — defaults shown below per provider)
# LLM_MODEL=claude-sonnet-4-6 # anthropic: Claude Sonnet 4.6 (default)
# LLM_MODEL=gpt-5.4                    # openai: GPT-5.4 (default)
# LLM_MODEL=gpt-5.4-mini               # openai: GPT-5.4 Mini (fast + cheap)
# LLM_MODEL=gemini-3.1-pro-preview     # gemini: Gemini 3.1 Pro (default)
# LLM_MODEL=gemini-2.5-flash           # gemini: Gemini 2.5 Flash (stable, fast)

# --- API Keys (set the one matching your LLM_PROVIDER) ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
# OPENAI_API_KEY=sk-xxxxx
# GEMINI_API_KEY=xxxxx
# BROWSER_USE_API_KEY=xxxxx

# --- Browser Settings ---
# HEADLESS=false
# MAX_CONCURRENT=3
