# --- LLM Provider ---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Model Selection ---
# LLM_MODEL=claude-sonnet-4-6          # primary model (default)
# LLM_FAST_MODEL=claude-haiku-4-5      # fast model for simple extractions
# LLM_CONTEXT_WINDOW=1000000           # override inferred context window if needed

# --- Browser Settings ---
# MAX_CONCURRENT=5                      # parallel browser contexts
# HEADLESS=false                        # set true for CI/server

# --- Auth (optional) ---
# AUTH_STORAGE_STATE=linkedin_auth.json # Playwright storage state for logged-in sessions

# --- Agent Behavior ---
# REFLECTION_MODE=full                  # full | light
# FINALIZE_ON_FAILURE=true              # best-effort done/fail before exiting
# ENABLE_FALLBACK_LLM=false             # use fallback model on retryable primary failures
# FALLBACK_LLM_MODEL=claude-haiku-4-5   # fallback model when enabled
