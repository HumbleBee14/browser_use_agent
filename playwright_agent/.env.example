# --- LLM Provider ---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Model Selection ---
# LLM_MODEL=claude-sonnet-4-6          # primary model (default)
# LLM_FAST_MODEL=claude-haiku-4-5      # fast model for summaries & memory distillation
# LLM_CONTEXT_WINDOW=1000000           # override inferred context window if needed

# --- Browser Settings ---
# MAX_CONCURRENT=5                      # parallel browser contexts
# HEADLESS=false                        # set true for CI/server

# --- Auth (optional) ---
# AUTH_STORAGE_STATE=linkedin_auth.json # Playwright storage state for logged-in sessions

# --- Agent Behavior ---
# REFLECTION_MODE=full                  # "full" = structured eval/memory/goal per step (recommended for long-horizon)
                                        # "light" = minimal prompt, saves tokens (good for simple single-page tasks)
# FINALIZE_ON_FAILURE=true              # on max_steps or LLM failure, make one last consolidation call
# ENABLE_FALLBACK_LLM=false             # try fallback model when primary fails with retryable errors
# FALLBACK_LLM_MODEL=claude-haiku-4-5   # which model to fall back to

# --- Multi-Action Batching (EXPERIMENTAL) ---
# When enabled, the LLM can return multiple actions per step (e.g. type + type + click).
# Reduces LLM calls and latency for form fills and repetitive extraction.
# Safety: aborts batch on navigation, failure, or page change. Each sub-action is logged individually.
# Keep false until you've tested with your specific workflows.
# ENABLE_MULTI_ACTIONS=false            # default: false (one action per LLM call)
# MAX_ACTIONS_PER_STEP=3                # max sub-actions per batch (browser-use uses 10, we recommend 3)
