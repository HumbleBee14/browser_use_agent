# Evidence output (generated at runtime)
evidence/
!evidence/.gitkeep

# Runtime memory (mutable, per-machine)
memory/*.json
!memory/.gitkeep

# Logs (generated at runtime)
logs/
!logs/.gitkeep

# Environment
.env
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Auth state (contains session cookies)
*_auth.json

# IDE
.idea/
.vscode/
*.swp
